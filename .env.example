# Local development only. Replace placeholders; never commit real secrets.

# Waymark database (docker compose postgres on 5433)
DATABASE_URL=postgresql://waymark:waymark_dev_only@localhost:5433/waymark

# UI basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=replace_me

# Grafana webhook contact point sends: Authorization: Bearer <this>
GRAFANA_WEBHOOK_SECRET=replace_me

OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_with_supported_model

# Fine-grained token: target repo only, contents:write + pull_requests:write
GITHUB_TOKEN=replace_me

PROMETHEUS_URL=http://localhost:9090

# Target (one trusted demo service)
TARGET_SERVICE=shop-backend
TARGET_ENDPOINT=/api/products
TARGET_REPO_URL=https://github.com/OWNER/REPO.git
TARGET_REPO_SUBDIR=backend
TARGET_BASE_URL=http://localhost:5002
TARGET_RUN_PORT=5102
TARGET_DATABASE_URL=postgresql://waymark:waymark_dev_only@localhost:5433/shop
TARGET_EDITABLE_PATHS=routes/,db.js

# Worker
WORKER_POLL_INTERVAL_SECONDS=3
WORKSPACE_ROOT=./.workspaces

# Gates
GATE_MIN_P95_IMPROVEMENT=0.2
GATE_MIN_REQUESTS=200
