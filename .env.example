# Local development only. Replace placeholders; never commit real secrets.

# TraceFix database (docker compose postgres on 5433)
DATABASE_URL=postgresql://tracefix:tracefix_dev_only@localhost:5433/tracefix

# Your Grafana webhook contact point must send: Authorization: Bearer <this> (scheme Bearer, credentials = this value).
# Generate one: openssl rand -hex 24
GRAFANA_WEBHOOK_SECRET=replace_me
# Used by scripts/send-sample-alert.mjs
TRACEFIX_URL=http://localhost:8100

OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_with_supported_model

# GitHub App installed on the target repo only: Contents RW, Pull requests RW, Metadata R
GITHUB_APP_ID=replace_me
# GitHub now accepts the Client ID as the JWT issuer instead of the App ID
GITHUB_APP_CLIENT_ID=replace_me
# After installing the app on the repo: the number at the end of .../settings/installations/<id>
GITHUB_APP_INSTALLATION_ID=replace_me
# Path to the app's downloaded .pem (secrets/ and *.pem are gitignored). Relative to the repo root.
GITHUB_APP_PRIVATE_KEY_PATH=secrets/tracefix-app.pem
# Alternative to the path: the key inline on one line with \n escapes
GITHUB_APP_PRIVATE_KEY=replace_me

# Your existing Prometheus and Grafana (the shop repo's docker compose by default)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
# p95 threshold used by triage; match the threshold of your Grafana alert rule
ALERT_P95_THRESHOLD_MS=200

# Target (one trusted demo service)
TARGET_SERVICE=shop-backend
TARGET_ENDPOINT=/api/products
TARGET_REPO_URL=https://github.com/OWNER/REPO.git
TARGET_REPO_SUBDIR=backend
TARGET_BASE_URL=http://localhost:5002
TARGET_RUN_PORT=5102
TARGET_DATABASE_URL=postgresql://tracefix:tracefix_dev_only@localhost:5433/shop
TARGET_EDITABLE_PATHS=routes/,db.js

# Worker
WORKER_POLL_INTERVAL_SECONDS=3
WORKSPACE_ROOT=./.workspaces

# Gates
GATE_MIN_P95_IMPROVEMENT=0.2
GATE_MIN_REQUESTS=100

# Env for the cloned target app only (TARGET_ENV_X → X). TraceFix's own secrets are never passed to target code.
TARGET_ENV_PGHOST=localhost
TARGET_ENV_PGPORT=5433
TARGET_ENV_PGUSER=tracefix
TARGET_ENV_PGPASSWORD=tracefix_dev_only
TARGET_ENV_PGDATABASE=shop

# Fixed k6 workload (Docker image grafana/k6), identical for baseline and candidate
LOADTEST_VUS=20
LOADTEST_DURATION=20s
K6_IMAGE=grafana/k6:1.3.0
